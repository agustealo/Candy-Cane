<?xml version="1.0"?>
<ruleset name="Candy Cane">
	<description>WordPress and PHP compatibility checks for the modernized Candy Cane theme surface.</description>

	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg value="ps"/>
	<config name="testVersion" value="7.4-"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<file>functions.php</file>
	<file>inc</file>
	<file>header.php</file>
	<file>footer.php</file>
	<file>comments.php</file>
	<file>loop-index.php</file>

	<exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
